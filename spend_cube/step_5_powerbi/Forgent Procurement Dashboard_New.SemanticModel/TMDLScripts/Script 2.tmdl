		column 'Sort Order'
			dataType: int64
			formatString: 0
			lineageTag: a7b8c9d0-e1f2-3a4b-5c6d-7e8f9a0b1c2d
			summarizeBy: none
			sourceColumn: [Sort Order]

			annotation SummarizationSetBy = Automatic

		partition DateCoverageMeasureList = calculated
			mode: import
			source =
					DATATABLE(
					    "Measure Name", STRING,
					    "Sort Order", INTEGER,
					    {
					        {"Due Date Coverage %", 1},
					        {"Promise Date Coverage %", 2},
					        {"Receipt Date Coverage %", 3},
					        {"Expected Receipt Date Coverage %", 4},
					        {"Arrived Date Coverage %", 5},
					        {"Open Orders Due Date Coverage %", 6},
					        {"Closed Orders Receipt Date Coverage %", 7},
					        {"Date Completeness Score %", 8}
					    }
					)

		annotation PBI_Id = a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6

