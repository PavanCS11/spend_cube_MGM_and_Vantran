	table DateCoverageMeasureList
		lineageTag: e5f6a7b8-c9d0-1e2f-3a4b-5c6d7e8f9a0b

		column 'Measure Name'
			dataType: string
			lineageTag: f6a7b8c9-d0e1-2f3a-4b5c-6d7e8f9a0b1c
			summarizeBy: none
			sourceColumn: [Measure Name]
			sortByColumn: 'Sort Order'

