		column intercompany
			dataType: string
			lineageTag: 483fe8d5-9d59-4e6e-9ff7-bac36e98ba1a
			summarizeBy: none
			sourceColumn: [intercompany]

			annotation SummarizationSetBy = Automatic

		partition DimSupplier = calculated
			mode: import
			source =
					ADDCOLUMNS (
					    VALUES ( po_fact_table[standardized_vendor_name] ),
					    "supplier_type",
					        MAXX (
					            FILTER ( po_fact_table, po_fact_table[standardized_vendor_name] = EARLIER ( po_fact_table[standardized_vendor_name] ) ),
					            po_fact_table[supplier_type]
					        ),
					    "vendor_location",
					        MAXX (
					            FILTER ( po_fact_table, po_fact_table[standardized_vendor_name] = EARLIER ( po_fact_table[standardized_vendor_name] ) ),
					            po_fact_table[vendor_location]
					        ),
					    "intercompany",
					        MAXX (
					            FILTER ( po_fact_table, po_fact_table[standardized_vendor_name] = EARLIER ( po_fact_table[standardized_vendor_name] ) ),
					            po_fact_table[intercompany]
					        )
					)

		annotation PBI_Id = 0819419355b34750a9bf7b5cc6d4a35c

	table CopperPriceIndex
		lineageTag: c9d0e1f2-a3b4-5678-cdef-789012345678

		column Year_Month
			dataType: string
