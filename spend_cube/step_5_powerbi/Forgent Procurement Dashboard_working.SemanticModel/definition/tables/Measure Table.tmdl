	/// ─── 12 - Overdue Aging Buckets ───
	/// days_until_due = due_date - today (negative when overdue)
	/// Negate to get "days overdue": -days_until_due = days past due
	measure 'Overdue 0-30 Days (Count)' =
			CALCULATE(
			    COUNTROWS(po_fact_table),
			    po_fact_table[is_overdue] = TRUE,
			    po_fact_table[days_until_due] <= -1,
			    po_fact_table[days_until_due] >= -30,
			    ALL('Time Intelligence')
			)
