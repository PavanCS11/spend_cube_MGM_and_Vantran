		lineageTag: a1000001-0001-0001-0001-00000000000a

	/// ─── 13 - Savings & PPV ───
	measure 'PPV Savings (by Category)' = ```
			
			SUMX (
			    VALUES ( po_fact_table[item_category_l1] ),
			    [PPV Savings]
			)
			
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 13 - Savings
		lineageTag: a1000002-0001-0001-0001-000000000001

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'PPV % Change' = ```
			
			VAR CurrentSpend = [Total Spend]
			VAR Savings = [PPV Savings]
			RETURN
			DIVIDE ( Savings, CurrentSpend + Savings, BLANK() )
			
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 13 - Savings
		lineageTag: a1000002-0001-0001-0001-000000000002

	measure 'Items with Price Decrease' = ```
			
			COUNTROWS (
			    FILTER (
			        VALUES ( po_fact_table[item_name_mpn] ),
			        VAR CurrentAvg = [Avg Unit Cost]
			        VAR PriorAvg =
			            CALCULATE (
			                [Avg Unit Cost],
			                SAMEPERIODLASTYEAR ( 'Time Intelligence'[Date] )
			            )
			        RETURN
			            NOT ISBLANK ( PriorAvg )
			                && CurrentAvg < PriorAvg * 0.90
			    )
			)
			
			```
		formatString: #,0
		displayFolder: 13 - Savings
		lineageTag: a1000002-0001-0001-0001-000000000003

	measure 'Net Price Movement' = ```
			
			VAR Increases =
			    SUMX (
			        FILTER (
			            VALUES ( po_fact_table[item_name_mpn] ),
			            NOT ISBLANK (
			                CALCULATE (
			                    [Avg Unit Cost],
			                    DATEADD ( 'Time Intelligence'[Date], -1, YEAR )
			                )
			            ) && [Total Quantity] > 0
			        ),
			        VAR Curr = [Avg Unit Cost]
			        VAR Prior =
			            CALCULATE (
			                [Avg Unit Cost],
			                DATEADD ( 'Time Intelligence'[Date], -1, YEAR )
			            )
			        VAR Qty = [Total Quantity]
			        RETURN
			            IF ( Curr > Prior, ( Curr - Prior ) * Qty, 0 )
			    )
			VAR Decreases = [PPV Savings]
			RETURN
			Decreases - Increases
			
			```
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 13 - Savings
		lineageTag: a1000002-0001-0001-0001-000000000004

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// ─── 14 - Lead Time Analysis ───
	measure 'Lead Time 0-7 Days' =
			CALCULATE (
			    COUNTROWS ( po_fact_table ),
			    po_fact_table[lead_time_days] >= 0,
			    po_fact_table[lead_time_days] <= 7
			)
		formatString: #,0
		displayFolder: 14 - Lead Time Analysis
		lineageTag: a1000003-0001-0001-0001-000000000001

	measure 'Lead Time 8-14 Days' =
			CALCULATE (
			    COUNTROWS ( po_fact_table ),
			    po_fact_table[lead_time_days] > 7,
			    po_fact_table[lead_time_days] <= 14
			)
		formatString: #,0
		displayFolder: 14 - Lead Time Analysis
		lineageTag: a1000003-0001-0001-0001-000000000002

	measure 'Lead Time 15-30 Days' =
			CALCULATE (
			    COUNTROWS ( po_fact_table ),
			    po_fact_table[lead_time_days] > 14,
			    po_fact_table[lead_time_days] <= 30
			)
		formatString: #,0
		displayFolder: 14 - Lead Time Analysis
		lineageTag: a1000003-0001-0001-0001-000000000003

	measure 'Lead Time 31-60 Days' =
			CALCULATE (
			    COUNTROWS ( po_fact_table ),
			    po_fact_table[lead_time_days] > 30,
			    po_fact_table[lead_time_days] <= 60
			)
		formatString: #,0
		displayFolder: 14 - Lead Time Analysis
		lineageTag: a1000003-0001-0001-0001-000000000004

	measure 'Lead Time 60+ Days' =
			CALCULATE (
			    COUNTROWS ( po_fact_table ),
			    po_fact_table[lead_time_days] > 60
			)
		formatString: #,0
		displayFolder: 14 - Lead Time Analysis
		lineageTag: a1000003-0001-0001-0001-000000000005

	measure 'Median Lead Time' = ```
			
			PERCENTILE.INC ( po_fact_table[lead_time_days], 0.5 )
			
			```
		formatString: 0
		displayFolder: 14 - Lead Time Analysis
		lineageTag: a1000003-0001-0001-0001-000000000006

	measure 'P90 Lead Time' = ```
			
			PERCENTILE.INC ( po_fact_table[lead_time_days], 0.9 )
			
			```
		formatString: 0
		displayFolder: 14 - Lead Time Analysis
		lineageTag: a1000003-0001-0001-0001-000000000007

	measure 'Lead Time YoY Change' = ```
			
			VAR Current = [Avg Lead Time]
			VAR Prior =
			    CALCULATE (
			        [Avg Lead Time],
			        DATEADD ( 'Time Intelligence'[Date], -1, YEAR )
			    )
			RETURN
			Current - Prior
			
			```
		formatString: 0
		displayFolder: 14 - Lead Time Analysis
		lineageTag: a1000003-0001-0001-0001-000000000008

	/// ─── 15 - Supplier Drillthrough ───
	measure 'Supplier OTD %' = ```
			
			VAR OnTime =
			    CALCULATE ( [Line Count], po_fact_table[on_time_vs_due_flag] = "On Time" )
			VAR Total =
			    CALCULATE ( [Line Count], NOT ( ISBLANK ( po_fact_table[on_time_vs_due_flag] ) ) )
			RETURN
			DIVIDE ( OnTime, Total, BLANK() )
			
			```
		formatString: 0%;-0%;0%
		displayFolder: 15 - Supplier Drillthrough
		lineageTag: a1000004-0001-0001-0001-000000000001

	measure 'Supplier Category Count' = COUNTROWS ( VALUES ( po_fact_table[item_category_l1] ) )
		formatString: 0
		displayFolder: 15 - Supplier Drillthrough
		lineageTag: a1000004-0001-0001-0001-000000000002

	measure 'Supplier Avg Lead Time' = AVERAGE ( po_fact_table[lead_time_days] )
		formatString: 0
		displayFolder: 15 - Supplier Drillthrough
		lineageTag: a1000004-0001-0001-0001-000000000003

	measure 'Supplier First Order' = FORMAT ( MIN ( po_fact_table[order_date] ), "MMM YYYY" )
		displayFolder: 15 - Supplier Drillthrough
		lineageTag: a1000004-0001-0001-0001-000000000004

	measure 'Supplier Spend Trend Spark' = ```
			
			VAR CurrentMonth =
			    CALCULATE ( [Total Spend], DATESMTD ( 'Time Intelligence'[Date] ) )
			VAR PriorMonth =
			    CALCULATE (
			        [Total Spend],
			        DATEADD ( 'Time Intelligence'[Date], -1, MONTH )
			    )
			RETURN
			IF (
			    CurrentMonth > PriorMonth,
			    UNICHAR ( 9650 ) & " " & FORMAT ( CurrentMonth, "$#,0" ),
			    IF (
			        CurrentMonth < PriorMonth,
			        UNICHAR ( 9660 ) & " " & FORMAT ( CurrentMonth, "$#,0" ),
			        UNICHAR ( 9654 ) & " " & FORMAT ( CurrentMonth, "$#,0" )
			    )
			)
			
			```
		displayFolder: 15 - Supplier Drillthrough
		lineageTag: a1000004-0001-0001-0001-000000000005

